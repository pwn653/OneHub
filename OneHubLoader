-- One Hub Loader :)

-- Message for Scriptblox Approvers :
--  this script does NOT require key for field with key = false. 

local DISCORD = "https://discord.gg/yNTHZAJvMd"
local GAMES = {
	{
		Name = "Blox Fruits",
		Ids = { 2753915549, 85211729168715, 79091703265657, 4442272183, 7449423635, 100117331123089 },
		Url = "https://api.luarmor.net/files/v4/loaders/b8cc4d20093305b26fb0e500137d8036.lua",
		Key = false,
	},
	{
		Name = "Throw Food For Pets",
		Ids = { 120219252362013 },
		Url = "https://raw.githubusercontent.com/pwn653/ThrowFoodForPets/refs/heads/main/script.lua",
		Key = false,
	},
	{
		Name = "Break & Steal Eggs",
		Ids = { 114326934417838 },
		Url = "https://api.luarmor.net/files/v4/loaders/199a194373b491edf4f65397786cb509.lua", 
		Key = true,
	},
}

local function notify(text, duration)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "One Hub",
			Text = text,
			Duration = duration or 5,
		})
	end)
end

local function getKey()
	local k
	pcall(function()
		k = (getgenv and getgenv().script_key) or script_key
	end)
	k = k and tostring(k) or ""
	k = k:gsub("^%s+", ""):gsub("%s+$", "")
	if k == "" or k == "KEY" or k == "YOUR_KEY" or k == "nil" then
		return nil
	end
	return k
end

local current
for _, g in ipairs(GAMES) do
	for _, id in ipairs(g.Ids) do
		if game.PlaceId == id or game.GameId == id then
			current = g
			break
		end
	end
	if current then
		break
	end
end

if not current then
	notify("This script is not supported in this game")
	return
end

if current.Key then
	local key = getKey()
	if not key then
		pcall(setclipboard, DISCORD)
		notify("Join our Discord (link copied) and click Get Script in the script channel to use " .. current.Name .. ".", 10)
		return
	end
	-- Luarmor reads the global script_key
	script_key = key
	pcall(function()
		getgenv().script_key = key
	end)
end

local src
for _ = 1, 3 do
	local ok, res = pcall(function()
		return game:HttpGet(current.Url)
	end)
	if ok and type(res) == "string" and #res > 50 then
		src = res
		break
	end
	task.wait(2)
end
if not src then
	notify("Could not download the " .. current.Name .. " script. Try again.")
	return
end

local fn, err = loadstring(src)
if not fn then
	notify("The " .. current.Name .. " script failed to load.")
	warn("[One Hub] " .. tostring(err))
	return
end
task.spawn(fn)
