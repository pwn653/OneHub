	return
end

local fn, err = loadstring(src)
if not fn then
	local said = src:gsub("<[^>]*>", " "):gsub("%s+", " "):sub(1, 140)
	pcall(setclipboard, said)
	notify("The " .. current.Name .. " script failed to load. Server said: " .. said, 15)
	return
end
task.spawn(fn)
