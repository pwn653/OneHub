	return
end

---------------------------------------------------------------- keys
local KEY_FILE = "OneHub/key_" .. (current.Url:match("loaders/(%w+)") or "main") .. ".txt"

local function clean(k)
	if type(k) == "table" then
		k = k[current.Name]
	end
	k = k and tostring(k) or ""
	k = k:gsub("^%s+", ""):gsub("%s+$", "")
	if k == "" or k == "KEY" or k == "YOUR_KEY" or k == "nil" then
		return nil
	end
	return k
end

local function pastedKey()
	local k
	pcall(function()
		k = (getgenv and getgenv().script_key) or script_key
	end)
	return clean(k)
end

local function savedKey()
	local k
	pcall(function()
		if isfile and isfile(KEY_FILE) then
			k = readfile(KEY_FILE)
		end
	end)
	return clean(k)
end

local function saveKey(k)
	pcall(function()
		if makefolder and not (isfolder and isfolder("OneHub")) then
			makefolder("OneHub")
		end
		writefile(KEY_FILE, k)
	end)
end

-- asks Luarmor if the key works for this script
local luarmor
local function checkKey(k)
	if not luarmor then
		pcall(function()
			luarmor = loadstring(game:HttpGet("https://sdkapi-public.luarmor.net/library.lua"))()
			luarmor.script_id = current.Url:match("loaders/(%w+)")
		end)
	end
	if not luarmor then
		return true -- can't check right now: let the script itself decide
	end
	local ok, res = pcall(luarmor.check_key, k)
	if not ok or type(res) ~= "table" then
		return true
	end
	local code = res.code
	if code == "KEY_VALID" then
		return true
	elseif code == "KEY_HWID_LOCKED" then
		return false, "This key is used on another device. Click Reset HWID in our Discord."
	elseif code == "KEY_EXPIRED" then
		return false, "This key has expired. Get a new one in our Discord."
	elseif code == "KEY_BANNED" then
		return false, "This key is banned."
	elseif code == "KEY_INCORRECT" or code == "KEY_INVALID" then
		return false, "Wrong key. Get yours for free in our Discord."
	end
	return false, tostring(res.message or code or "Could not check the key, try again.")
end

-- opens the invite inside the Discord app (and copies the link as a backup)
local function joinDiscord()
	pcall(setclipboard, DISCORD)
	local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
	if req then
		task.spawn(pcall, req, {
			Url = "http://127.0.0.1:6463/rpc?v=1",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json", Origin = "https://discord.com" },
			Body = HttpService:JSONEncode({
				cmd = "INVITE_BROWSER",
				nonce = HttpService:GenerateGUID(false),
				args = { code = DISCORD_CODE },
			}),
		})
	end
end

