-- One Hub Loader :)

local game_ids = { 2753915549, 85211729168715, 79091703265657, 4442272183, 7449423635, 100117331123089 }

for _, v in ipairs(game_ids) do
	if game.PlaceId == v then
		local src = game:HttpGet("https://api.luarmor.net/files/v4/loaders/b8cc4d20093305b26fb0e500137d8036.lua")
		task.spawn(loadstring(src))
		return
	end
end

game:GetService("StarterGui"):SetCore("SendNotification", {
	Title = "One Hub",
	Text = "This script only works in Blox Fruits.",
	Duration = 5,
})
